# Opcional. Se preenchida, o Java precisa mandar o mesmo valor em
# AI_VALIDATION_API_KEY (Authorization: Bearer …).
AI_VALIDATION_API_KEY=

# Visão das evidências. No Render (512 MB) use Gemini e NÃO ligue o TensorFlow:
#   GEMINI_API_KEY=...   (AI Studio: https://aistudio.google.com/app/apikey)
#   SOULIE_VISION_BACKEND=gemini
#   SOULIE_VISION_FALLBACK_TF=false
#
# auto = Gemini se houver chave, senão TensorFlow (dev local).
# tensorflow = só o modelo local (estoura RAM no plano free).
# gemini = só Gemini; 429/timeout viram 503 (FAILED no Java), não REJECTED.
SOULIE_VISION_BACKEND=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SOULIE_VISION_FALLBACK_TF=false
